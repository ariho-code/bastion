# Copy to .env.local for local dev, and set the same in Vercel →
# Settings → Environment Variables for production.

# Public site URL — canonical links, sitemap, Open Graph, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Advanced Deep Scan backend (the Go engine + Python brain, deployed on Render).
# The /advanced page proxies to the brain, which drives the engine. After
# deploying via render.yaml, paste the brain's public URL here.
# Locally: run `go run ./cmd/server` (engine, :8080) and uvicorn (brain, :8090).
BASTION_BRAIN_URL=http://localhost:8090

# Email delivery (report emails + waitlist). Gmail App Password recommended:
#   Google Account → Security → 2-Step Verification → App passwords
#   Paste the 16-char password WITHOUT spaces.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# Optional: custom SMTP host/port (defaults to Gmail on 465).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Set to "false" to disable owner lead-notification emails.
LEAD_NOTIFY=true

# REST API keys — comma-separated "key:tier" (tier = pro | agency).
# e.g. API_KEYS=bk_live_abc123:pro,bk_live_xyz789:agency
API_KEYS=
# Advanced + enterprise scanning is currently FREE and open to everyone.
# Set API_REQUIRE_KEY=true to LOCK it down — then those scans (and the REST API)
# require a valid API key. Leave false to keep the whole platform open.
API_REQUIRE_KEY=false

# Scheduled monitoring:
# 1) Create a Vercel KV (Upstash Redis) store in your project → it auto-injects
#    KV_REST_API_URL and KV_REST_API_TOKEN (shown here for reference).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 2) Set a random CRON_SECRET; Vercel Cron sends it as a Bearer token to
#    /api/cron/monitor, which runs daily (see vercel.json).
CRON_SECRET=
